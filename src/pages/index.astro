---
import Layout from '~/layouts/PageLayout.astro';

import Hero2 from '~/components/widgets/Hero2.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'TraxBee - Building Bridges in IoT',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero2 Widget ******************* -->

  <Hero2
    tagline="TraxBee - Building Bridges in IoT"
    actions={[
      { variant: 'primary', text: 'Contact Us', href: '/contact' , icon:'tabler:mail-filled'},
      { text: 'Learn more', href: '#features' },
    ]}
    image={{
      src: '~/assets/images/hero5.svg',
      alt: 'TraxBee Hero Image',
    }}
  >
    <Fragment slot="title">
      Connecting the future <br /> one device at a time with our <span class="text-accent dark:text-white highlight"
        >IoT</span
      > Solutions<br />
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        We build things @ <span class="font-semibold">TraxBee</span> for transforming the future through seamless IoT integration, </span
      >
      Empowering your world with cutting-edge connectivity solutions.
    </Fragment>
  </Hero2>
  <!-- Hero Widget ******************* -->

  <!-- Note Widget ******************* -->

  <Note />

  <!-- Features Widget *************** -->

  <Features
    id="aboutus"
    tagline="About Us"
    title="Who are we?"
    subtitle="We are a ODM(Original Design Manufacturer) company based out of India 🇮🇳, we design and produce components that no one else does."
    items={[
      {
        title: 'Innovative Product Development',
        description:
          'Driving innovation through cutting-edge design and development, bringing your IoT concepts to life with creativity and technical expertise.',
        icon: 'tabler:bulb',
      },
      {
        title: 'End-to-End Integration',
        description:
          'Comprehensive end-to-end integration services, from concept and design to manufacturing and deployment, streamlining your product development journey.',
        icon: 'tabler:components',
      },
      {
        title: 'Time-to-Market Efficiency',
        description:
          'Efficient design and production processes to reduce time-to-market, getting your IoT products in the hands of users quickly and effectively.',
        icon: 'tabler:rocket',
      },
      {
        title: 'Collaborative Partnership',
        description:
          'A collaborative partnership approach, working closely with clients to understand their vision and goals, fostering long-term relationships built on trust and mutual success.',
        icon: 'tabler:building-stadium',
      },
      {
        title: 'Continuous Innovation',
        description:
          "Dedicated to staying at the forefront of IoT advancements, continually innovating to bring the latest technologies and features to your products.",
        icon: 'tabler:repeat',
      },
      {
        title: 'Quality Assurance',
        description:
          'Rigorous quality assurance processes to ensure the highest standards in every aspect of product development, from hardware design to software implementation.',
        icon: 'tabler:list-check',
      },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    id="products"
    isReversed
    tagline="What we do @ TraxBee"
    title="Our Products"
    items={[
      {
        title: 'LimePi Core',
        description:
          "LimePi Core is abd sdfsdf asdasd asdasd asda sd asd asd asd asd asd as d asd a sd as d asd a sd",
      },
      {
        title: 'LimePi Pro',
        description:
          'LimePi Pro is Loren ipsum adsdasd asdasd ertert dfgd qweewr dasfsd dfgfg asdfasdasd',
      },
      {
        title: 'LimePi Zero',
        description:
          'LimePi Zero is first generation of LimePi multi-purpose IoT micro processor board. Build for anyone from an pro to beginners. ',
      },
    ]}
    image={{
      src: '~/assets/images/LimePiFamily.png',
      alt: 'Colorful Image',
    }}
    callToAction={{
      target: '_blank',
      text: 'Visit Official Site',
      icon: 'tabler:chevron-right',
      href: 'https://limepi.org',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Family of Linux SBCs that we call LimePi with ❤️ </h3>
      LimePi is an umbrella term for range of micro processor board(s) and add-on plugins to expand functionality of those boards offered by TraxBee.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    items={[
      {
        title: '8Channel-4-20mA  ModBus Converter',
        description: `Desc goes here:....Tailor the template effortlessly to match your brand's identity and requirements, making your website distinct and saving you time.`,
      },
      {
        title: 'Automotive DashBoard',
        description:
          'Digital Dashboard solution for next generation of vehicles with modern comprehensive looks.',
      },
      {
        title: 'Industrial 4G Router',
        description:
          "A SoC designed specifically for industrial application that allows any device to connect to 4G networks with minimum configuration required.",
      },
      {
        title: 'SmartAccess NFC Reader',
        description:
          'Desc goes here:............',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1600132806370-bf17e65e942f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2194&q=80',
      alt: 'Blueprint Image',
    }}
  >
    <Fragment slot="content">Some more miscellaneous products that we deal in.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isReversed
    isAfterContent
    items={[
      {
        title: 'Milk Data Processor',
        description:
          'Empowering Dairy Industry of India with state of the art device for fair, secure and transparent transactions between dairy and farmers.',
      },
      {
        title: 'RTU Modbus',
        description:
          'Ensure your website stays aligned with the latest trends and technologies through regular updates and enhancements.',
      },
      {
        title: 'RTU Ethernet',
        description:
          'Lorem Ipsum asdasda eretyry erwrterye werrtyrty qwerwetert qweweter.',
      }
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1611462985358-60d3498e0364?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Product Images',
    }}
  >

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget ****************** -->
  <Content
    id="projects"
    title="Projects we've accomplished"
    subtitle="Empowering clients through a diverse portfolio, our accomplished projects showcase innovative IoT solutions, custom-designed with precision and excellence."
    isReversed
    items={[
      {
        title: 'What we achieved:',
        description:
          'Predictive Maintenance is smart way to predict machine breakdowns before hand and prevent them by fixing the root cause of the problem by correctly identifying them.',
      },
      {
        title: 'How we achived:',
        description:
          'A machine is equipped with necessary sensors like vibration, temperature, pressure, etc.. and the produced data is passed on through a pipeline of algorithms every second that resides in LimePi Zero that also acts as a Gateway which predicts for amy anomalities in the machine and raises the necessary alarms and alerts. All this data can be monitored in real time on a custom built web application and analysed with innovative dashboards.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1658248165252-71e116af1b34?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=928&q=80',
      alt: 'PdM Image',
    }}
    callToAction={{
      target: '_blank',
      text: 'Read the full blog',
      icon: 'tabler:chevron-right',
      href: '#',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Predictive Maintenance: <br /><span class="text-2xl">Smart Algorithmic Predictions for Maintenance at L&T</span>
      </h3>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

 <!-- Content Widget **************** -->

  <Content
    isReversed
    isAfterContent={true}
    items={[
      {
        title: 'What We Achived:',
        description:
          'Smart Monitoring of cranes installed at L&T for safety and increase effecincy by monitoring movements of crane in realtime on dashboard and raising necessary alarms and alerts when safety locks are bypassed to prevent accidents.',
      },
      {
        title: 'How we achived:',
        description: `Cranes motor's VFD parameters are monitored and anti collition mechanism is established with innovative technology and the resultant data produced is passed on to LimeCore Pro device which acted as gateway as well as raised alarms and alerts with algorithms and data is beautifully presented on custom built web application dashboard for analysis.`,
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1619983081563-430f63602796?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=774&q=80',
      alt: 'Art and Music Poster Image',
    }}
    callToAction={{
      target: '_blank',
      text: 'Read full blog',
      icon: 'tabler:chevron-right',
      href: '#',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Smart Crane Monitoring: <br /><span class="text-2xl">Elevate Efficiency and Safety of Cranes @ L&T</span>
      </h3>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->


  <!-- HighlightedPosts Widget ******* -->

  <!-- <BlogLatestPosts
    title="Find out more content in our Blog"
    information={`The blog is used to display AstroWind documentation.
                        Each new article will be an important step that you will need to know to be an expert in creating a website using Astro + Tailwind CSS.
                        Astro is a very interesting technology. Thanks.
                `}
  /> -->



  <!-- Stats Widget ****************** -->

  <Stats
    stats={[
      { title: 'Since', amount: '2007' },
      { title: 'Projects', amount: '100+' },
      { title: 'Satisfied Customers', amount: '20+' },
      { title: 'Years of experience (Micro-controllers)', amount: '25+' },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Email Us',
        href: 'mailto:info@traxbee.in',
        target: '_blank',
        icon: 'tabler:mail-filled',
      },
    ]}
  >
    <Fragment slot="title">
      Email us <br class="block sm:hidden" /><span class="sm:whitespace-nowrap">to convert your ideas to reality</span>
    </Fragment>

    <Fragment slot="subtitle">
      Pitch us your ideas and confirm your order quantities, <br class="hidden md:inline" />We'll design and deliver to your expectations
    </Fragment>
  </CallToAction>
</Layout>
